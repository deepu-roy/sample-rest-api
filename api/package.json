{
    "name": "sample-rest-api-backend",
    "version": "1.0.0",
    "description": "Backend API for the Sample REST API",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "start:js": "node server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "dev:js": "nodemon server.js",
        "test": "jest --detectOpenHandles",
        "test:watch": "jest --watch",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "typecheck": "tsc --noEmit",
        "seed": "ts-node src/db/seed.ts",
        "seed:prod": "node dist/db/seed.js"
    },
    "dependencies": {
        "body-parser": "^1.20.2",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "sqlite3": "^5.1.6",
        "swagger-ui-express": "^4.6.3",
        "swagger-jsdoc": "^6.2.8",
        "axios": "^1.6.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.16.0",
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.10.0",
        "@types/supertest": "^6.0.2",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.6",
        "eslint": "^9.16.0",
        "eslint-config-prettier": "^9.1.0",
        "jest": "^29.7.0",
        "jsdom": "^22.1.0",
        "node-fetch": "^2.6.7",
        "nodemon": "^2.0.22",
        "prettier": "^3.4.2",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.17.0"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "moduleFileExtensions": [
            "ts",
            "js"
        ],
        "testMatch": [
            "**/tests/**/*.test.ts"
        ],
        "setupFilesAfterEnv": [
            "./src/tests/setup.ts"
        ],
        "transform": {
            "^.+\\.ts$": "ts-jest"
        },
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        }
    }
}
